# Contoh Script Properties untuk Keuangan Harian.
# JANGAN pernah mengisi nilai asli di berkas ini atau meng-commit kredensial (Standar §5.4).
#
# Cara mengisi: editor Apps Script -> Project Settings -> Script Properties -> Add script property
# (Berkas ini hanya dokumentasi; Apps Script tidak membaca .env.)

# Kunci API Anthropic untuk pembacaan bukti (WAJIB).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx-GANTI-DENGAN-KUNCI-ANDA

# PIN gerbang dashboard (WAJIB). Kosongkan properti ini = dashboard terbuka tanpa PIN.
APP_PIN=000000

# Link spreadsheet "CASHFLOW & BIAYA <bulan berjalan>" (diganti tiap awal bulan).
# Bisa juga diatur lewat tab Setelan pada dashboard.
CASHFLOW_URL=https://docs.google.com/spreadsheets/d/GANTI_ID_SPREADSHEET/edit
